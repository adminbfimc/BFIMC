# Copy this file to .env and fill in the values for the mailbox that receives forms.
PORT=3000
# Supabase project settings (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Use a long random value in production.
SESSION_SECRET=replace-with-a-long-random-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=website@example.com
MAIL_TO=admin@beatitudescooperative.com
